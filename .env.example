# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Your environment -------------------------------------------------------------------
ANYCO_OKTA_DOMAIN=https://<your-org>.okta.com    # an Okta org with API Access Management
ANYCO_AWS_PROFILE=<aws-profile>                  # optional; default credential chain if empty
ANYCO_AWS_REGION=us-west-2
# ANYCO_AWS_ACCOUNT=<12-digit id>                # optional; read from STS if unset
DEMO_USER_PASSWORD=<password of the demo users>  # only the test scripts use it

# --- Optional: only for okta_setup.py / okta_teardown.py (an Okta admin's API token) ----
# OKTA_API_TOKEN=                               # remove it (and revoke it) once Okta is set up

# --- From the Okta Admin Console (docs/okta-setup.md; okta_setup.py fills these in) -----
# Part 2 · Pattern A
OKTA_LOGIN_CLIENT_ID=                            # app anyco-eng-login-app
ANYCO_LOGIN_CLIENT_SECRET=                       # its client secret
OKTA_AGENT_CLIENT_ID=                            # app anyco-pr-review-agent-app
OKTA_AGENT_CLIENT_SECRET=                        # its client secret
OKTA_BACKEND_CLIENT_ID=                          # app anyco-console-backend-app (the backend's token exchange)
ANYCO_BACKEND_CLIENT_SECRET=                     # its client secret
OKTA_USERS_AS_ID=                                # authorization server anyco-users-as (aus...)
OKTA_AGENT_A_AS_ID=                              # authorization server anyco-agent-a-as (aus...)
OKTA_GATEWAY_AS_ID=                              # authorization server anyco-gateway-as (aus...)

# Part 3 · Pattern B (leave empty to skip)
OKTA_AGENT_B_AS_ID=                              # authorization server anyco-agent-b-as (aus...)
OKTA_BACKEND_AGENT_CLIENT_ID=                    # AI agent anyco-backend-agent-oai (your backend), Client registration tab
OKTA_BACKEND_AGENT_KID=                          # its public key's Key ID
OKTA_AGENT_B_CLIENT_ID=                          # AI agent anyco-pr-review-agent-b-oai, Client registration tab
OKTA_AGENT_B_KID=                                # its public key's Key ID

# Part 4 · Pattern C (leave empty to skip)
OKTA_EVENT_SOURCE_CLIENT_ID=                     # app anyco-event-source-app
OKTA_EVENT_SOURCE_KID=                           # its public key's KID
OKTA_EVENT_AGENT_CLIENT_ID=                      # AI agent anyco-event-agent-oai, Client registration tab
OKTA_EVENT_AGENT_KID=                            # its public key's Key ID
OKTA_EVENT_AGENT_AS_ID=                          # authorization server anyco-event-agent-as
OKTA_PARTNER_AS_ID=                              # authorization server anyco-partner-mcp-as
